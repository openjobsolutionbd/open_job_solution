/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/bcs-mcq/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /bcs-mcq/

/mcq-job-solution/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /mcq-job-solution/

/mcq-job-solution/primary-mcq/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /mcq-job-solution/primary-mcq/

/mcq-job-solution/ministry-mcq/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /mcq-job-solution/ministry-mcq/

/written-exam/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /written-exam/

/current-affairs/docs/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /current-affairs/docs/

/_assets/fonts/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
