{
  "version": "0.2",
  "language": "bn,en",
  "import": ["@cspell/dict-bn/cspell-ext.json"],
  "dictionaries": ["bn", "en_US", "known-words"],
  "dictionaryDefinitions": [
    {
      "name": "known-words",
      "path": "./known-words.txt",
      "addWords": true
    }
  ],
  "ignoreRegExpList": [
    ["^###.*###$", "gm"]
  ],
  "numbers": false
}
