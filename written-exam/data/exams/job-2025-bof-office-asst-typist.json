    "subject": "math",
    "topic": "সূচক",
    "qno": 12,
    "marks": 4,
    "type": "math",
    "question": "3x − y = 12 হলে, 8^x/2^y = কত?",
    "steps": [
      "প্রদত্ত রাশি = 8^x/2^y",
      "= (2³)^x/2^y = 2^(3x)/2^y",
      "= 2^(3x−y) = 2^12 [∵ 3x−y=12]",
      "= 4096"
    ],
    "answer": "4096"
  },
