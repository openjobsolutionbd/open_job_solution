    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 11,
    "marks": 5,
    "type": "math",
    "question": "$a + \\frac{1}{a} = 7$ হলে, $a^3 + \\frac{1}{a^3}$ এর মান কত?",
    "steps": [
      "$a^3 + \\frac{1}{a^3} = \\left(a + \\frac{1}{a}\\right)^3 - 3 \\cdot a \\cdot \\frac{1}{a}\\left(a + \\frac{1}{a}\\right)$",
      "$= \\left(a + \\frac{1}{a}\\right)^3 - 3\\left(a + \\frac{1}{a}\\right)$",
      "$= (7)^3 - 3 \\cdot 7 = 343 - 21 = 322$"
    ],
    "answer": "$322$"
  },
