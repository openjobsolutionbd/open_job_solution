    "question": "উৎপাদকে বিশ্লেষণ করঃ x⁴ − 4x + 3",
    "steps": [
      "x⁴ − 4x + 3",
      "= x⁴ − x³ + x³ − x² + x² − x − 3x + 3",
      "= x³(x−1) + x²(x−1) + x(x−1) − 3(x−1)",
      "= (x−1)(x³+x²+x−3)",
      "= (x−1){x³ − x² + 2x² − 2x + 3x − 3}",
      "= (x−1){x²(x−1) + 2x(x−1) + 3(x−1)}",
      "= (x−1)(x−1)(x²+2x+3)"
    ],
    "answer": "(x−1)²(x²+2x+3)"
  },
