  {
    "id": "job-2025-nipor-steno-q11",
    "examId": "job-2025-nipor-steno",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 11,
    "marks": 8,
    "type": "math",
    "question": "দুইটি সংখ্যার বর্গের সমষ্টি ১৩ এবং সংখ্যা দুইটির গুণফল ৬ হলে, সংখ্যা দুইটির বর্গের অন্তর কত?",
    "steps": [
      "মনে করি, সংখ্যা দুটি x ও y",
      "সংখ্যা দুটির বর্গের অন্তর = x² − y² = ?",
      "১ম শর্তে, x² + y² = ১৩",
      "২য় শর্তে, xy = ৬",
      "এখন, (x² − y²)² = (x² + y²)² − 4x².y²",
      "= (১৩)² − ৪(xy)²",
      "= ১৬৯ − ৪.৬²",
      "= ১৬৯ − ১৪৪",
      "= ২৫"
    ],
    "answer": "∴ x² − y² = ৫"
  },
