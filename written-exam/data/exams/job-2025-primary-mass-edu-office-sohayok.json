    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 18,
    "marks": 5,
    "type": "math",
    "question": "x + y = 6 হলে, x³ + y³ + 18xy এর মান কত?",
    "steps": [
      "x³ + y³ + 18xy",
      "= x³ + y³ + 3×6×xy",
      "= x³ + y³ + 3(x+y)×xy [মান বসিয়ে]",
      "= (x+y)³",
      "= (6)³",
      "= 216"
    ],
    "answer": "216"
  },
  {
    "id": "job-2025-primary-mass-edu-office-sohayok-q19",
    "examId": "job-2025-primary-mass-edu-office-sohayok",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 19,
    "marks": 5,
    "type": "math",
    "question": "4x² − 23x + 33 কে উৎপাদকে বিশ্লেষণ করুন।",
    "steps": [
      "4x² − 23x + 33",
      "= 4x² − 12x − 11x + 33",
      "= 4x(x−3) − 11(x−3)",
      "= (x−3)(4x−11)"
    ],
    "answer": "(x−3)(4x−11)"
  },
  {
    "id": "job-2025-primary-mass-edu-office-sohayok-q20",
    "examId": "job-2025-primary-mass-edu-office-sohayok",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 20,
    "marks": 5,
    "type": "math",
    "question": "দুইটি সংখ্যার যোগফল ১৭ এবং গুণফল ৭২। বড় সংখ্যাটি কত?",
    "steps": [
      "মনে করি, ছোট সংখ্যাটি ক, বড় সংখ্যাটি ১৭ − ক",
      "প্রশ্নমতে, ক(১৭−ক) = ৭২",
      "বা, ১৭ক − ক² = ৭২",
      "বা, ক² − ১৭ক + ৭২ = ০",
      "বা, ক² − ৯ক − ৮ক + ৭২ = ০",
      "বা, ক(ক−৯) − ৮(ক−৯) = ০",
      "বা, (ক−৯)(ক−৮) = ০",
      "∴ ক = ৯ অথবা ৮",
      "সুতরাং বড় সংখ্যা ৯"
    ],
    "answer": "৯"
  },
