  {
    "id": "job-2025-primary-mass-edu-steno-typist-q14",
    "examId": "job-2025-primary-mass-edu-steno-typist",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 14,
    "marks": 5,
    "type": "math",
    "question": "√x + 1/√x = a হলে, দেখাও যে, x² + 1/x² এর মান কত?",
    "steps": [
      "দেওয়া আছে, √x + 1/√x = a",
      "বা, (√x + 1/√x)² = a²",
      "বা, (√x)² + 2.√x.1/√x + (1/√x)² = a²",
      "বা, x + 2 + 1/x = a²",
      "বা, x + 1/x = a² − 2",
      "বা, (x + 1/x)² = (a²−2)²",
      "বা, x² + 2.x.1/x + (1/x)² = a⁴ − 2a.2 + 4",
      "বা, x² + 1/x² = a⁴ − 4a + 4 − 2",
      "∴ x² + 1/x² = a⁴ − 4a + 2"
    ],
    "answer": "a⁴ − 4a + 2"
  },
  {
    "id": "job-2025-primary-mass-edu-steno-typist-q15",
    "examId": "job-2025-primary-mass-edu-steno-typist",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 15,
    "marks": 5,
    "type": "math",
    "question": "a + 1/a = √6 হলে, a³ + 1/a³ = 3√6 প্রমাণ করুন।",
    "steps": [
      "L.H.S = a³ + 1/a³",
      "= a³ + (1/a)³",
      "= (a + 1/a)³ − 3×a×1/a(a + 1/a)",
      "= (√6)³ − 3×√6",
      "= 6√6 − 3√6",
      "= 3√6",
      "= R.H.S"
    ],
    "answer": "a³ + 1/a³ = 3√6 (প্রমাণিত)"
  },
