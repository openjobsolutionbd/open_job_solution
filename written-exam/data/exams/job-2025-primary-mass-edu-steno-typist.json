    "examId": "job-2025-primary-mass-edu-steno-typist",
    "subject": "math",
    "topic": "বীজগণিত",
    "qno": 11,
    "marks": 5,
    "type": "math",
    "question": "উৎপাদকে বিশ্লেষণ করঃ (x+5)(x+13)−9",
    "steps": [
      "(x+5)(x+13)−9",
      "= (x+5)(x+5+8)−9",
      "মনে করি, x+5 = a",
      "প্রদত্ত রাশি = a(a+8) − 9",
      "= a² + 8a − 9",
      "= a² + 9a − a − 9",
      "= a(a+9) − 1(a+9)",
      "= (a+9)(a−1)",
      "= (x+5+9)(x+5−1)",
      "= (x+14)(x+4)"
    ],
    "answer": "(x+14)(x+4)"
  },
