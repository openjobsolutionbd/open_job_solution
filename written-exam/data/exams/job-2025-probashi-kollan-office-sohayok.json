    "type": "math",
    "question": "x − ১/x = ৩ হলে, x⁴ + ১/x⁴ = কত?",
    "steps": [
      "দেওয়া আছে, x − ১/x = ৩",
      "প্রদত্ত রাশি = x⁴ + ১/x⁴ = (x²)² + (১/x²)²",
      "= (x² + ১/x²)² − ২.x².১/x²",
      "= {(x − ১/x)² + ২.x.১/x}² − ২",
      "= (৩² + ২)² − ২ = (৯+২)² − ২ = (১১)² − ২ = ১২১ − ২"
    ],
    "answer": "উত্তর: = ১১৯"
  },
