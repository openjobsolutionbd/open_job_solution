    "type": "math",
    "question": "উৎপাদকে বিশ্লেষণ করুনঃ x² − 2x − 15",
    "steps": [
      "x² − 2x − 15",
      "= x² − 5x + 3x − 15",
      "= x(x − 5) + 3(x − 5)",
      "= (x − 5)(x + 3)"
    ],
    "answer": "(x − 5)(x + 3)"
  },
  {
    "id": "job-2025-pwd-office-sohayok-q16",
    "examId": "job-2025-pwd-office-sohayok",
    "subject": "math",
    "topic": "জ্যামিতি",
    "qno": 16,
    "marks": 5,
    "type": "math",
    "question": "10 সে.মি ব্যাসের বৃত্তের পরিধি কত?",
    "steps": [
      "মনে করি, বৃত্তের ব্যাসার্ধ r",
      "∴ বৃত্তের ব্যাস = 2r এবং বৃত্তের পরিধি = 2πr",
      "প্রশ্নানুসারে, 2r = 10",
      "বা, r = 10/2",
      "∴ r = 5 সে.মি",
      "∴ বৃত্তের পরিধি = 2πr = 2 × 3.1416 × 5 সে.মি.",
      "= 31.41 সে.মি. (প্রায়)"
    ],
    "answer": "31.41 সে.মি. (প্রায়)"
  },
