    "examId": "job-2025-pwd-office-sohayok",
    "subject": "math",
    "topic": "উৎপাদকে বিশ্লেষণ",
    "qno": 14,
    "marks": 5,
    "type": "math",
    "question": "x³ − 2x², x² − 4, xy − 2y এর গ.সা.গু নির্ণয় করুন।",
    "steps": [
      "১ম রাশি = x³ − 2x² = x²(x − 2)",
      "২য় রাশি = x² − 4 = (x+2)(x − 2)",
      "৩য় রাশি = xy − 2y = y(x − 2)",
      "নির্ণেয় গ.সা.গু = (x − 2)"
    ],
    "answer": "(x − 2)"
  },
  {
    "id": "job-2025-pwd-office-sohayok-q15",
    "examId": "job-2025-pwd-office-sohayok",
    "subject": "math",
    "topic": "উৎপাদকে বিশ্লেষণ",
    "qno": 15,
