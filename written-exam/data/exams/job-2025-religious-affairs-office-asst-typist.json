  {
    "id": "job-2025-religious-affairs-office-asst-typist-q17",
    "examId": "job-2025-religious-affairs-office-asst-typist",
    "subject": "math",
    "topic": "লাভ-ক্ষতি",
    "qno": 17,
    "marks": 4,
    "type": "math",
    "question": "একটি পণ্য বিক্রয় করে পাইকারি বিক্রেতার ২০% এবং খুচরা বিক্রেতার ২০% লাভ হয়। যদি পণ্যটির খুচরা বিক্রয়মূল্য ৫৭৬ টাকা হয়, তবে পাইকারী বিক্রেতার ক্রয়মূল্য কত?",
    "steps": [
      "মনে করি, পাইকারী বিক্রেতার ক্রয়মূল্য x টাকা",
      "২০% লাভে বিক্রয়মূল্য x + x × ২০/১০০ = x + x/৫ = ৬x/৫ টাকা",
      "২০% লাভে খুচরা বিক্রেতার বিক্রয়মূল্য ৬x/৫ + (৬x/৫ × ২০/১০০) = ৬x/৫ + ৬x/২৫ = (৩০x + ৬x)/২৫ = ৩৬x/২৫",
      "প্রশ্নমতে, ৩৬x/২৫ = ৫৭৬",
      "বা, ৩৬x = ৫৭৬ × ২৫",
      "বা, x = (৫৭৬ × ২৫)/৩৬ ∴ x = ৪০০"
    ],
    "answer": "৪০০ টাকা"
  },
  {
    "id": "job-2025-religious-affairs-office-asst-typist-q18",
    "examId": "job-2025-religious-affairs-office-asst-typist",
    "subject": "math",
    "topic": "সরল সুদ",
    "qno": 18,
    "marks": 4,
    "type": "math",
    "question": "কোন আসল ৫ বছরে মুনাফা-আসলে ১৬৮০ টাকা এবং ৯ বছরে মুনাফা আসল ২০৬৪ টাকা হয়।",
    "steps": [
      "আসল + ৯ বছরের সুদ = ২০৬৪ টাকা",
      "আসল + ৫ বছরের সুদ = ১৬৮০ টাকা",
