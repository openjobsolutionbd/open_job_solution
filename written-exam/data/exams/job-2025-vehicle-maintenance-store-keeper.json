    "id": "job-2025-vehicle-maintenance-store-keeper-q13",
    "examId": "job-2025-vehicle-maintenance-store-keeper",
    "subject": "math",
    "topic": "উৎপাদকে বিশ্লেষণ",
    "qno": 13,
    "marks": 5,
    "type": "math",
    "question": "উৎপাদকে বিশ্লেষণ করুনঃ x³ + 6x²y + 11xy² + 6y³",
    "steps": [
      "x³ + 6x²y + 11xy² + 6y³",
      "= x³ + 6x²y + 12xy² + 8y³ − xy² − 2y³",
      "= {x³ + 3.x².2y + 3.x.(2y)² + (2y)³} − xy² − 2y³",
      "= (x + 2y)³ − y²(x + 2y)",
      "= (x + 2y){(x + 2y)² − y²}",
      "= (x + 2y)(x + 2y + y)(x + 2y − y)",
      "= (x + 2y)(x + 3y)(x + y)"
    ],
    "answer": "(x + y)(x + 2y)(x + 3y)"
  },
